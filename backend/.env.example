# Application
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Database (Neon Postgres or local Postgres)
# Note: For Neon, append ?sslmode=require
DATABASE_URL=postgresql+asyncpg://agentguard:dev_password@localhost:5432/agentguard

# GitHub App Credentials
GITHUB_APP_ID=dummy_app_id
GITHUB_WEBHOOK_SECRET=development_webhook_secret_key_12345
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0...\n-----END RSA PRIVATE KEY-----"

# LLM Providers Configuration (JSON format)
LLM_PROVIDERS_CONFIG='{"providers":{"gemini":{"api_key":"dummy_gemini_key","models":["gemini-2.0-flash"],"role":"primary","task_types":["reasoning","code_generation"]},"groq":{"api_key":"dummy_groq_key","models":["llama-3.1-70b-versatile"],"role":"fallback","task_types":["classification","formatting"]}},"default_primary":"gemini","default_fallback":"groq"}'

# Execution & Sandbox
SANDBOX_PROVIDER=e2b
E2B_API_KEY=dummy_e2b_key

# Policy Engine (OPA)
OPA_URL=http://localhost:8181
