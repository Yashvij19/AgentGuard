# ==============================================================================
# AgentGuard Backend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `.env` in the backend folder and adjust with your credentials.

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. Database Connection (PostgreSQL Strictly Required)
# ------------------------------------------------------------------------------
# NOTE: AgentGuard strictly requires PostgreSQL with the `asyncpg` driver.
# SQLite is NOT supported because AgentGuard relies on PostgreSQL transaction-scoped
# advisory locks (`pg_try_advisory_xact_lock`) to serialize concurrent pull-request
# webhooks safely without race conditions or deadlocks.
#
# Option A: Local Native PostgreSQL installed on Windows / Laptop:
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/agentguard
#
# Option B: Local Docker PostgreSQL container:
# DATABASE_URL=postgresql+asyncpg://agentguard:dev_password@localhost:5432/agentguard
#
# Option C: Cloud Managed PostgreSQL (e.g. Neon, Supabase, AWS RDS):
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xyz.neon.tech/agentguard?sslmode=require

# ------------------------------------------------------------------------------
# 3. Policy Engine (Open Policy Agent - OPA)
# ------------------------------------------------------------------------------
# OPA evaluates security policies and Rego rules with fail-closed security.
# Start OPA locally via:
#   - Standalone Windows Binary: .\opa.exe run --server --addr :8181
#   - Docker: docker run -d --name opa -p 8181:8181 openpolicyagent/opa:latest run --server --addr :8181
OPA_URL=http://localhost:8181

# ------------------------------------------------------------------------------
# 4. LLM Providers Configuration
# ------------------------------------------------------------------------------
# You can configure provider credentials using individual environment variables below (Method A)
# OR as a single JSON blob (Method B).
# NOTE: Active roles (Primary, Fallback, Specialist) and active models can also
# be assigned dynamically directly from the Web UI dashboard (/providers).

# Method A: Direct Environment Variables (Recommended for local dev)

# Provider 1: Google Gemini (Primary Reasoning & Code Generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODELS=gemini-2.0-flash,gemini-1.5-pro

# Provider 2: Groq (High-Throughput LPU Reasoning & Classification)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# Provider 3: NVIDIA NIM (Reasoning Fallback)
NVIDIA_NIM_API_KEY=your_nvidia_nim_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODELS=meta/llama-3.3-70b-instruct

# Provider 4: OpenAI-Compatible (Local vLLM, Ollama, DeepSeek, or OpenAI)
OPENAI_COMPAT_API_KEY=your_openai_compat_key_here
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_MODELS=gpt-4o,gpt-4o-mini

# Method B: Comprehensive JSON Configuration (Alternative for Cloud/Kubernetes secret injection)
# If provided, this is merged with the individual environment variables above:
# LLM_PROVIDERS_CONFIG='{"providers":{"gemini":{"api_key":"your_key","models":["gemini-2.0-flash"],"role":"primary"},"groq":{"api_key":"your_key","models":["llama-3.3-70b-versatile"],"role":"fallback"}},"default_primary":"gemini","default_fallback":"groq"}'

# ------------------------------------------------------------------------------
# 5. GitHub Integration Credentials
# ------------------------------------------------------------------------------
# Required for receiving PR webhooks and posting review comments / patches.
# For local dev / testing without a GitHub App, dummy credentials can be kept.
GITHUB_APP_ID=dummy_app_id
GITHUB_WEBHOOK_SECRET=development_webhook_secret_key_12345
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA0...\n-----END RSA PRIVATE KEY-----"

# ------------------------------------------------------------------------------
# 6. Sandbox Execution Layer (E2B Runner or Local)
# ------------------------------------------------------------------------------
# Providers: 'e2b' (ephemeral microVMs in cloud) or 'github_actions'
SANDBOX_PROVIDER=e2b
# Set your E2B API Key (from https://e2b.dev).
# If left empty, 'dummy_e2b_key', or 'mock', the runner operates in deterministic
# local mock mode without incurring cloud charges or needing Docker microVMs.
E2B_API_KEY=dummy_e2b_key

# ------------------------------------------------------------------------------
# 7. Human-In-The-Loop Notifications (Optional)
# ------------------------------------------------------------------------------
# Webhooks triggered when an ActionIntent requires human custodian approval.
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
DASHBOARD_BASE_URL=http://localhost:5173
